{
  "name": "forum-360",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-logo": "node scripts/prepare-logo.mjs",
    "copy-assets": "node scripts/prepare-logo.mjs && node scripts/copy-public-assets.mjs",
    "seed:content": "node scripts/export-content-seed.mjs",
    "seed:content:force": "node scripts/export-content-seed.mjs --force",
    "predev": "node scripts/prepare-logo.mjs && node scripts/copy-public-assets.mjs",
    "prebuild": "node scripts/prepare-logo.mjs && node scripts/copy-public-assets.mjs --force",
    "dev": "vite",
    "dev:client": "vite --host 127.0.0.1 --port 5174",
    "dev:server": "node server/index.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "admin:hash": "node server/create-password-hash.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
